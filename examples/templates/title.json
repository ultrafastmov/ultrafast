{
  "version": 1,
  "format": { "width": 1920, "height": 1080, "fps": 30, "duration": 6, "motion_blur": { "samples": 6, "shutter": 0.5 } },
  "output": "finish",
  "nodes": {
    "world": { "op": "marble", "params": { "filaments": 0.6 } },
    "dim": { "op": "adjust", "inputs": { "source": "world" }, "params": { "exposure": -1.2 } },
    "title": { "op": "text", "params": { "text": "Your Title", "font": "Geist", "weight": 700, "size": 200, "align": "center", "valign": "middle",
      "position": [960, 520], "color": "#ffffff", "tracking": -6,
      "stagger": 0.05, "stagger_order": "center",
      "glyph_offset": { "keys": [ [0.3, [0, 80], { "bezier": [0.16, 1, 0.3, 1] }], [1.1, [0, 0]] ] },
      "glyph_opacity": { "keys": [ [0.3, 0], [0.6, 1] ] } } },
    "sub": { "op": "text", "params": { "text": "a subtitle that breathes", "font": "Geist", "size": 44, "align": "center", "valign": "middle",
      "position": { "wiggle": { "frequency": 0.4, "amplitude": [6, 4], "base": [960, 660] } }, "color": "#ffffffb0", "tracking": 2,
      "reveal": { "keys": [ [1.0, 0], [2.0, 24] ] } } },
    "comp": { "op": "over", "inputs": ["dim", "title", "sub"] },
    "lit": { "op": "bloom", "inputs": { "source": "comp" }, "params": { "intensity": 0.5 } },
    "finish": { "op": "grain", "inputs": { "source": "lit" } }
  }
}
