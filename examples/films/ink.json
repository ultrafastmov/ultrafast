  "ink": {
   "op": "shader",
   "params": {
    "code": "\nfloat fbm(float3 p) {\n  float s = 0.0, a = 0.5;\n  for (int i = 0; i < 4; i++) { s += a * snoise(p); p = p * 2.07 + float3(17.1, 3.7, 9.2); a *= 0.5; }\n  return s;\n}\nfloat4 shade(float2 pos, float px) {\n  float2 uv = (pos - size() * 0.5) / size().y;\n  float t = time() * 0.07;\n  float3 p = float3(uv * 0.6 + float2(0.0, t * 0.5), t);\n  float2 q = float2(fbm(p), fbm(p + float3(5.2, 1.3, 2.0)));\n  float2 r = float2(fbm(p + float3(2.6 * q, 0.0) + float3(1.7, 9.2, t)),\n                    fbm(p + float3(2.6 * q, 0.0) + float3(8.3, 2.8, -t)));\n  float v = fbm(p + float3(2.4 * r, 0.0));\n  // Marbled ink: dark body, luminous filaments where the field crosses zero.\n  float3 deep = float3(0.003, 0.004, 0.012);\n  float3 blue = float3(0.015, 0.04, 0.16);\n  float body = smoothstep(-0.25, 0.55, v);\n  float fil = pow(saturate(1.0 - abs(v + 0.08) * 4.0), 7.0);\n  float fil2 = pow(saturate(1.0 - abs(r.y - 0.1) * 5.0), 9.0) * 0.6;\n  float3 hue = lerp(float3(0.95, 0.20, 0.32), float3(1.0, 0.66, 0.32), saturate(q.x * 1.4 + 0.5));\n  float3 c = lerp(deep, blue, body * 0.8);\n  c += hue * fil * param(1) * 1.4 + float3(0.55, 0.65, 1.0) * fil2 * param(2);\n  return float4(c, 1.0);\n}",
    "resolution": 0.5,
    "u1": {
     "keys": [
      {
       "t": 3.4,
       "v": [
        0.85
       ],
       "ease": "in_out_cubic"
      },
      {
       "t": 4.2,
       "v": [
        0.4
       ]
      },
      {
       "t": 6.2,
       "v": [
        0.4
       ],
       "ease": "in_out_cubic"
      },
      {
       "t": 7.2,
       "v": [
        0.7
       ]
      }
     ]
    },
    "u2": 1.0
   }
  },
  "molten": {
   "op": "shader",
   "params": {
    "code": "\nfloat4 shade(float2 pos, float px) {\n  float2 uv = pos / size();\n  float t = time() * 0.25;\n  float n = snoise(float3(uv * float2(1.2, 2.2), t)) * 0.5 + snoise(float3(uv * 3.1 + 7.0, t * 1.3)) * 0.25;\n  float3 gold = float3(1.0, 0.70, 0.36), rose = float3(1.0, 0.28, 0.42), white = float3(1.0, 0.94, 0.86);\n  float3 c = lerp(rose, gold, saturate(n + 0.5));\n  c = lerp(c, white, pow(saturate(n * 1.3 + 0.35), 4.0));\n  return float4(c * 1.15, 1.0);\n}"
   }
