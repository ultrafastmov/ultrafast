  "coral": {
   "op": "feedback",
   "params": {
    "code": "\nfloat hash21(float2 p) { return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453); }\nfloat4 update(float2 pos, float px) {\n    float mask = input(0, pos).a;\n    if (step_index() == 0) {\n        float spot = step(0.982, hash21(floor(pos / (px * 3.0))));\n        return float4(1.0, spot * mask, 0.0, 1.0);\n    }\n    float2 c = prev(pos).xy;\n    float2 lap = -c\n        + 0.2 * (prev(pos + float2(px, 0)).xy + prev(pos - float2(px, 0)).xy\n               + prev(pos + float2(0, px)).xy + prev(pos - float2(0, px)).xy)\n        + 0.05 * (prev(pos + float2(px, px)).xy + prev(pos - float2(px, px)).xy\n                + prev(pos + float2(px, -px)).xy + prev(pos + float2(-px, px)).xy);\n    float a = c.x, b = c.y;\n    float kill = lerp(param(2), param(1), mask);\n    float r = a * b * b;\n    a += lap.x - r + param(0) * (1.0 - a);\n    b += 0.5 * lap.y + r - (kill + param(0)) * b;\n    return float4(saturate(a), saturate(b), 0.0, 1.0);\n}\n",
    "start": 8.4,
    "resolution": 0.6,
    "substeps": 26,
    "u": [
     0.0545,
     0.062,
     0.09
    ],
    "u2": {
     "keys": [
      {
       "t": 8.4,
       "v": [
        0.09
       ]
      },
      {
       "t": 10.6,
       "v": [
        0.09
       ]
      },
      {
       "t": 12.0,
       "v": [
        0.0635
       ]
      }
     ]
    }
   },
   "inputs": {
    "in0": "grow_word"
   }
  },
  "coral_lit": {
   "op": "shader",
   "params": {
    "code": "\nfloat4 shade(float2 pos, float px) {\n    float e = 2.5;\n    float b = input(0, pos).y;\n    float bx = input(0, pos + float2(e, 0)).y - input(0, pos - float2(e, 0)).y;\n    float by = input(0, pos + float2(0, e)).y - input(0, pos - float2(0, e)).y;\n    float3 n = normalize(float3(-bx * 5.0, -by * 5.0, 1.0));\n    float3 l = normalize(float3(-0.45, -0.75, 0.55));\n    float diff = saturate(dot(n, l));\n    float spec = pow(saturate(dot(reflect(-l, n), float3(0, 0, 1))), 30.0);\n    float m = smoothstep(0.1, 0.3, b);\n    float2 uv = pos / size();\n    float3 sea = lerp(srgb_to_linear(float3(0.02, 0.09, 0.13)), srgb_to_linear(float3(0.01, 0.03, 0.06)), uv.y);\n    float3 coral = srgb_to_linear(float3(1.0, 0.42, 0.33));\n    float3 tip = srgb_to_linear(float3(1.0, 0.86, 0.72));\n    float3 col = lerp(coral, tip, smoothstep(0.28, 0.48, b)) * (0.35 + 0.85 * diff) + spec * 0.8;\n    // A soft shadow under the growth.\n    float sh = input(0, pos - float2(-10.0, -16.0)).y;\n    sea *= 1.0 - 0.6 * smoothstep(0.1, 0.35, sh);\n    return float4(lerp(sea, col, m), 1.0);\n}\n"
   },
   "inputs": {
    "in0": "coral"
   }
