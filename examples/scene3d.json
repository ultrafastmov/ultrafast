{
  "version": 1,
  "format": { "width": 1920, "height": 1080, "fps": 60, "duration": 6.0 },
  "output": "comp",
  "nodes": {
    "bg": { "op": "gradient", "params": { "kind": "radial", "a": "#2b3a55", "b": "#0b1020", "radius": 1200 } },

    "label": { "op": "text", "params": { "text": "ultrafast", "size": 300, "weight": 800, "position": [960, 540], "align": "center", "valign": "middle", "color": "#ffffff" } },
    "label_bg": { "op": "gradient", "params": { "a": "#ff4d6d", "b": "#7b2ff7", "start": [0, 0], "end": [1920, 1080] } },
    "card_tex": { "op": "over", "inputs": { "fg": "label", "bg": "label_bg" } },

    "card": { "op": "mesh", "inputs": { "texture": "card_tex" }, "params": {
      "primitive": "plane", "scale": [3.2, 1.8, 1], "position": [-1.2, 0.3, 0], "roughness": 0.35,
      "rotation": { "keys": [ { "t": 0, "v": [0, 25, 0], "ease": "in_out_cubic" }, { "t": 3, "v": [0, -25, 0], "ease": "in_out_cubic" }, { "t": 6, "v": [0, 25, 0] } ] } } },
    "ball": { "op": "mesh", "params": { "primitive": "sphere", "segments": 48, "position": [2.0, 0.6, 0.5], "scale": 1.3, "color": "#f5c542", "metallic": 1, "roughness": 0.25 } },
    "donut": { "op": "mesh", "params": { "primitive": "torus", "segments": 48, "position": [1.6, -1.1, 1.0], "scale": 1.6, "color": "#4dd4ff", "roughness": 0.6,
      "rotation": { "keys": [ { "t": 0, "v": [60, 0, 0] }, { "t": 6, "v": [60, 360, 0] } ] } } },
    "floor": { "op": "mesh", "params": { "primitive": "plane", "rotation": [-90, 0, 0], "position": [0, -1.9, 0], "scale": [14, 14, 1], "color": "#20283c", "roughness": 0.9 } },
    "key": { "op": "light", "params": { "direction": [0.4, 0.9, 0.7], "intensity": 3.2, "color": "#fff3e0" } },
    "rim": { "op": "light", "params": { "kind": "point", "position": [3.5, 2.0, -2.0], "intensity": 18, "color": "#7fb3ff" } },
    "cam": { "op": "camera", "params": { "target": [0, 0, 0], "fov": 40,
      "orbit": { "keys": [ { "t": 0, "v": [-12, 12, 7.5], "ease": "in_out_cubic" }, { "t": 6, "v": [12, 18, 7.0] } ] } } },
    "scene": { "op": "render3d", "inputs": { "camera": "cam", "card": "card", "ball": "ball", "donut": "donut", "floor": "floor", "key": "key", "rim": "rim" },
      "params": { "ambient": 0.25 } },
    "comp": { "op": "over", "inputs": { "fg": "scene", "bg": "bg" } }
  }
}
