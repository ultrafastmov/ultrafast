# ultrafast API key, sent as `Authorization: Bearer <key>`. `ultrafast serve`
# prints one on first start (docs/service/SELF_HOST.md).
ULTRAFAST_API_KEY=

# The MCP endpoint. Defaults to http://localhost:8080/mcp: `ultrafast serve` on
# this machine. Another server's /mcp works the same way. (ultrafast Cloud's
# https://mcp.ultrafast.mov is not open yet.)
# ULTRAFAST_MCP_URL=https://video.example.com/mcp

# The model, as provider/model-id. Default: anthropic/claude-sonnet-5-5.
# MODEL=openai/gpt-6.2-astra

# A key for the provider in MODEL.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
