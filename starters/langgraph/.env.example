# ultrafast API key, sent as `Authorization: Bearer <key>`.
ULTRAFAST_API_KEY=

# The MCP endpoint. Defaults to https://mcp.ultrafast.mov; self-hosted:
# ULTRAFAST_MCP_URL=http://localhost:8080/mcp

# The model, as provider/model-id. Default: anthropic/claude-sonnet-5-5.
# MODEL=openai/gpt-5.5

# A key for the provider in MODEL.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
