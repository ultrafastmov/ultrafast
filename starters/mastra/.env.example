# ultrafast API key, sent as `Authorization: Bearer <key>`.
ULTRAFAST_API_KEY=

# The MCP endpoint. Defaults to https://mcp.ultrafast.mov; self-hosted:
# ULTRAFAST_MCP_URL=http://localhost:8080/mcp

# The model, as a Mastra model router id. Default: anthropic/claude-sonnet-5-5.
# MODEL=openai/gpt-6.2-astra

# The key for the provider in MODEL (Mastra reads <PROVIDER>_API_KEY).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
